# Renomeie este arquivo para .env e preencha com suas credenciais

# Variáveis do Banco de Dados MySQL
DB_HOST="localhost"
DB_USER="root"
DB_PSWD="admin"
DB_NAME="iot_camila_db"

# Variáveis do Broker MQTT (Ex: HiveMQ Cloud)
MQTT_BROKER="seu_broker_aqui.hivemq.cloud"
MQTT_PORT=8883
MQTT_USER="seu_usuario_mqtt"
MQTT_PSWD="sua_senha_mqtt"
MQTT_TOPIC="smart40n1" # Tópico principal para escutar